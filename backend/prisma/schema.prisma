generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id          String   @id @default(uuid())

  name        String
  status      String   @default("pending") // pending, processing, paused, completed
  dripPerDay  Int      @default(30)
  urls        Url[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Url {
  id             String    @id @default(uuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  link           String
  status         String    @default("queued") // queued, processing, submitted, failed, completed
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  strategy       String?
  errorMessage   String?
  lastAttemptAt  DateTime?
  discoveredAt   DateTime?
  createdAt      DateTime  @default(now())

  @@index([campaignId])
  @@index([status])
}

model ApiKey {
  id             String    @id @default(uuid())
  keyHash        String    @unique
  label          String?
  plan           String    @default("free") // free, starter, pro, agency
  creditsBalance Int       @default(100) // Default credits for new keys
  lastUsedAt     DateTime?
  requestCount   Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

}
